NODE_ENV=development
AOWEB_TEST_MODE=false
INITIAL_ONLINE_RECORD=0
PORT=7666
API_BASE_URL=http://127.0.0.1:3001
RESET_CONNECTED_CHARACTERS_ON_STARTUP=false
TOKEN_AUTH=changeme

# Editor de mapas: activo por defecto fuera de produccion.
EDITOR_ENABLED=true

# IPs de proxies de confianza (coma). Solo desde esos pares se aceptan los
# headers X-Real-IP / CF-Connecting-IP / X-Forwarded-For. Vacio: se confia en
# loopback y redes privadas, y desde IPs publicas se usa la IP del socket.
TRUSTED_PROXY_IPS=
