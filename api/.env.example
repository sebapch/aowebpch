PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aoweb
TOKEN_AUTH=changeme

# Lista separada por comas. En produccion es obligatorio: sin esto se rechaza
# todo cross-origin (no se refleja el Origin recibido).
CORS_ORIGIN=http://localhost:3000

# Desde que pares se acepta X-Forwarded-For. Sintaxis de express `trust proxy`.
TRUST_PROXY=loopback, uniquelocal

# Anti fuerza bruta. Poner AUTH_RATE_LIMIT_DISABLED=true solo en entornos de
# test: la suite de integracion crea decenas de cuentas desde la misma IP.
AUTH_RATE_LIMIT_DISABLED=false
AUTH_LOGIN_MAX_FAILURES_PER_IDENTIFIER=10
AUTH_LOGIN_MAX_FAILURES_PER_IP=30
AUTH_REGISTER_MAX_PER_IP=20

# Cuenta habilitada para editar datos de juego (/admin/game-data/*). Sin al
# menos uno de los dos configurado, esos endpoints devuelven 403.
GAME_DATA_ADMIN_EMAIL=
GAME_DATA_ADMIN_ACCOUNT_ID=
# Secreto extra que agrega el proxy de Next. Si esta vacio no se exige.
GAME_DATA_ADMIN_PROXY_TOKEN=
